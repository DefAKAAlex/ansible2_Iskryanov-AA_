
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            margin: 40px;
        }
        .container {
            max-width: 800px;
            margin: auto;
            padding: 30px;
        }
        h1 { text-align: center; }
        .info { margin: 20px 0; padding: 10px; background: #f5f5f5;  }
        .label { font-weight: bold; color: #764ba2; }
        .privet { text-align: center; margin-top: 30px; font-style: italic; color: #764ba2; }
    </style>
</head>
<body>
    <div class="container">
        <h1>SysInfo</h1>
        <div class="info">
            <p><span class="label">Hostname:</span> {{ ansible_hostname }}</p>
            <p><span class="label">IP Address:</span> {{ ansible_default_ipv4.address }}</p>
            <p><span class="label">CPU:</span> {{ ansible_processor[0] }} ({{ ansible_processor_cores }} cores)</p>
            <p><span class="label">RAM:</span> {{ (ansible_memtotal_mb / 1024) | round(2) }} GB</p>
            <p><span class="label">First HDD:</span>
               {% for mount in ansible_mounts %}
                 {% if mount.mount == '/' %}
                   {{ mount.size_total | int | filesizeformat }}
                 {% endif %}
               {% endfor %}
            </p>
            <p><span class="label">OS:</span> {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
        </div>
        <div class="privet">
            Privet, SysAdmin!
        </div>
    </div>
</body>
</html>